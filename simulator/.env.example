# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# Cumulocity tenant ID (e.g. t10452223)
C8Y_TENANT=your-tenant-id

# Cumulocity username
C8Y_USERNAME=your.username@example.com

# Cumulocity password
C8Y_PASSWORD=your-password

# Cumulocity base URL (no trailing slash)
C8Y_BASE_URL=https://your-tenant.eu-latest.cumulocity.com

# Cumulocity managed object ID of the simulated device
C8Y_DEVICE_ID=your-device-id
